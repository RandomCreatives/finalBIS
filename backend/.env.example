# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Project Settings -> API -> service_role).
# Bypasses Row Level Security. Server-side only — never expose to a browser.
SUPABASE_SERVICE_KEY=

# Signing secret for our own JWTs. Minimum 32 characters.
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# How long a session lasts (zeit/ms format).
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Telegram login & notifications.
#
# 1. Talk to @BotFather:  /newbot  ->  choose a name  ->  copy the token
#    into TELEGRAM_BOT_TOKEN.
# 2. The username you gave the bot goes in TELEGRAM_BOT_USERNAME (no leading
#    @). It drives the login widget on the frontend (served via
#    /api/auth/telegram-config — no frontend rebuild needed).
# 3. Register your production domain with the bot:  @BotFather -> /setdomain
#    -> pick the bot -> enter the exact domain that serves the site.
#    (The widget only works on HTTPS domains registered this way.)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Google Drive integration (optional — files stored on Drive, metadata in DB).
#
# 1. Create a Google Cloud project and enable the Drive API
# 2. Create a Service Account, download the JSON key
# 3. Set GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY to the JSON string
# 4. Share your Drive folder with the service account email
# 5. Set GOOGLE_DRIVE_FOLDER_ID to the shared folder ID
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
