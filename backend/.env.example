# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash), e.g. https://your-app.vercel.app
FRONTEND_URL=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Project Settings -> API -> service_role).
# Bypasses Row Level Security. Server-side only — never expose to a browser.
SUPABASE_SERVICE_KEY=

# Signing secret for our own JWTs. Minimum 32 characters.
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# How long a session lasts (zeit/ms format).
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Telegram login & notifications.
#
# 1. Talk to @BotFather:  /newbot  ->  choose a name  ->  copy the token
#    into TELEGRAM_BOT_TOKEN.
# 2. The username you gave the bot goes in TELEGRAM_BOT_USERNAME (no leading
#    @). It drives the login widget on the frontend (served via
#    /api/auth/telegram-config — no frontend rebuild needed).
# 3. Register your production domain with the bot:  @BotFather -> /setdomain
#    -> pick the bot -> enter the exact domain that serves the site.
#    (The widget only works on HTTPS domains registered this way.)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_ENABLED=

# ---------------------------------------------------------------------------
# SMTP Email Configuration (optional).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Google Drive integration (optional — files stored on Drive, metadata in DB).
#
# 1. Create a Google Cloud project and enable the Drive API
# 2. Create a Service Account, download the JSON key
# 3. Set GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY to the JSON string
# 4. Share your Drive folder with the service account email
# 5. Set GOOGLE_DRIVE_FOLDER_ID to the shared folder ID
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Daily attendance reminders (optional) --------------------------------
# Main teachers whose class has no homeroom register get a bell reminder
# (plus a Telegram message if they linked Telegram) from this time on school
# days, and the office gets a digest of missing registers. School time is
# always Addis Ababa (GMT+3). Default 08:45 — registration ends at 08:30.
ATTENDANCE_REMINDER_TIME=08:45
# Protects GET /api/cron/attendance-reminders (the Vercel cron in vercel.json).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Any long random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Administrative & Utility Scripts Environment Variables (optional)
# Pass these when running backend/scripts/*.js
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@bisnoc.local
# ADMIN_PASSWORD=your_secure_admin_password
# ADMIN_NAME="System Administrator"
# SCHOOL_NAME="British International School, NOC Gerji"
# ACADEMIC_YEAR="2026/2027"
# CLASS_CAPACITY=30
# YEAR3_CLASSES="Blue,Yellow,Red,Green"
# YEAR4_CLASSES="Blue,Purple,Lavender,Crimson,Green,Yellow,Magenta,Red,Violet,Orange"
# APPLY=true
# TELEGRAM_WEBHOOK_URL="https://your-app.vercel.app/api/telegram/webhook"
# API_URL="http://localhost:5000/api"
# STAFF_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# Web Push (PWA notifications). Generate once:
#   node -e "const {generateVAPIDKeys}=require('web-push');console.log(generateVAPIDKeys().publicKey)"
# Set VAPID_PUBLIC_KEY on the frontend too (REACT_APP_VAPID_PUBLIC_KEY) so
# the browser can subscribe. VAPID_PRIVATE_KEY is backend-only.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@bisnoc.local
