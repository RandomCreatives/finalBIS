{
  "version": 2,
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 3 */5 * *"
    },
    {
      "path": "/api/cron/attendance-reminders",
      "schedule": "0 6 * * 1-5"
    }
  ],
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "tma/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "frontend/favicon.ico"
    },
    {
      "src": "/tma",
      "dest": "tma/index.html"
    },
    {
      "src": "/tma/assets/(.*)",
      "dest": "tma/assets/$1"
    },
    {
      "src": "/tma/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|json|svg|woff|woff2|ttf|eot|map|txt|html|webmanifest)$",
      "dest": "tma/$1.$2"
    },
    {
      "src": "/tma/(.*)",
      "dest": "tma/index.html"
    },
    {
      "src": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|json|svg|woff|woff2|ttf|eot|map|txt|html)$",
      "dest": "frontend/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
