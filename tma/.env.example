# Base URL of the backend API (no trailing slash, no /api suffix).
#
# In production leave this EMPTY: the Mini App at /tma/ and the API at /api/
# are served from the same Vercel domain, so the app calls relative URLs.
# Set it only when the API lives on another origin.
#
# Local development: `npm run dev` proxies /api to http://localhost:5000
# (override with VITE_DEV_API_PROXY), so this can stay empty too.
VITE_API_URL=

# Where the Vite dev server forwards /api requests. Defaults to the local
# Express server.
VITE_DEV_API_PROXY=http://localhost:5000
