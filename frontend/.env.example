# Base URL of the backend API (no trailing slash, no /api suffix).
# Local development:
REACT_APP_API_URL=http://localhost:5000

# Production on Vercel: leave EMPTY (or unset). The root vercel.json serves
# the API and the static site from the SAME domain, so requests to /api/...
# are same-origin and need no base URL. Do not point at localhost.
# REACT_APP_API_URL=

# Telegram Login Widget bot username (no leading @). OPTIONAL — the frontend
# now reads the bot username from the backend (/api/auth/telegram-config), so
# setting TELEGRAM_BOT_USERNAME on the server is enough. This variable is only
# an offline fallback; leave blank to rely on the backend.
REACT_APP_TELEGRAM_BOT_USERNAME=
